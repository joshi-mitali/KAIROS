      "css": ".ds-nav{background:var(--shell,#192d53);padding:18px;width:224px}.ds-nav-item{font-family:'Manrope Variable',sans-serif;cursor:pointer;width:100%;display:flex;align-items:center;gap:8px;text-align:left;background:transparent;color:#bbc9e0;padding:13px 14px;border:0;border-radius:8px;font-size:14px;font-weight:600;margin:4px 0;min-height:44px}.ds-nav-item.ds-selected{background:#324d7b;color:#fff}.ds-nav-item:hover{background:#2b436c;color:#fff}.ds-nav-item:focus-visible{outline:3px solid var(--focus,#89aaf0);outline-offset:3px;}"
