    },
    {
      "name": "Stock search",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Selected instrument and exchange remain visible above an editable search field.",
      "html": "<div class=\"ds-search\"><div class=\"ds-listing\">RELIANCE <small>NSE</small></div><label class=\"ds-search-field\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m16 16 4 4\"/></svg><input aria-label=\"Search NSE or BSE stocks\" placeholder=\"Search any stock\"/></label></div>",
      "css": ".ds-search{font-family:'Manrope Variable',sans-serif;max-width:340px}.ds-listing{display:flex;gap:7px;align-items:center;color:var(--ink,#172945);font-size:12px;font-weight:650;margin-bottom:6px}.ds-listing small{font-size:10px;color:var(--muted,#596b83);font-weight:500}.ds-search-field{display:flex;align-items:center;gap:8px;min-height:42px;border:1px solid var(--line,#e1e7f0);border-radius:8px;padding:0 12px;background:var(--surface,#fff);color:var(--muted,#596b83)}.ds-search-field input{font:inherit;font-size:13px;color:var(--ink,#172945);width:100%;min-width:0;border:0;padding:10px 0;background:transparent;outline:0}.ds-search-field input::placeholder{color:var(--muted,#596b83);opacity:1}.ds-search-field input:hover{border-color:#a6b7cf}.ds-search-field input:focus-visible{outline:3px solid var(--focus,#89aaf0);outline-offset:3px;}.ds-search-field input:disabled{opacity:.65}@media(max-width:700px){.ds-search-field input{font-size:16px}}"
    },
