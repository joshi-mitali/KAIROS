      "html": "<button class=\"ds-primary\">Run analysis</button>",
      "css": ".ds-primary{font-family:'Manrope Variable',sans-serif;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:11px 16px;border-radius:8px;font-size:11px;font-weight:750;transition:background .18s ease,border-color .18s ease,box-shadow .18s ease;border:0;background:var(--blue,#294e96);color:var(--surface,#fff)}.ds-primary:hover:not(:disabled){background:#203f7c}.ds-primary:focus-visible{outline:3px solid var(--focus,#89aaf0);outline-offset:3px;}.ds-primary:disabled{opacity:.55;cursor:not-allowed}"
