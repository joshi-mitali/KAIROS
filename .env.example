# KAIROS — Indian Stock Market Pipeline Configuration
# Copy this file to .env and adjust variables as needed.
# Do NOT commit your actual .env file with real credentials to version control.

# Application Settings
KAIROS_ENV=development
LOG_LEVEL=INFO
KAIROS_DATA_DIR=data

# Indian Stock Market Scope (Configurable NSE Symbols)
KAIROS_TARGET_TICKERS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
KAIROS_HISTORY_YEARS=10

# Existing MCP Server Configuration File
KAIROS_MCP_CONFIG=config/mcp_servers.json

# Alpha Vantage MCP Server (Optional API Key - Evaluated for BSE)
ALPHAVANTAGE_API_KEY=

# Reddit MCP Server (Optional OAuth2 - r/IndianStockMarket, r/IndiaInvestments)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Storage & Database (Optional PostgreSQL / Supabase adapter)
DATABASE_URL=
