# KAIROS Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# Do NOT commit your actual .env file with real credentials to version control.

# Application Settings
KAIROS_ENV=development
LOG_LEVEL=INFO
KAIROS_DATA_DIR=data

# SEC EDGAR Requirements (Fair-Access Compliant User-Agent: CompanyName AdminContact@domain.com)
SEC_EDGAR_USER_AGENT="KAIROS-Institutional-Trader research@kairos-trader.edu"

# Reddit API Credentials (Official OAuth - Leave empty if using local permitted samples/fixtures)
REDDIT_AUTHORIZED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="Mozilla/5.0 (compatible; KAIROS-Trader-Audit/1.0)"

# Financial News Providers
NEWS_PROVIDER=gdelt
FINNHUB_API_KEY=

# Storage & Database (Optional PostgreSQL / Supabase adapter)
# If unset, the pipeline defaults strictly to local JSON/CSV/Parquet file storage.
DATABASE_URL=

# MCP Configuration
MCP_SERVER_NAME="KAIROS-Market-Data-MCP"
MCP_SERVER_VERSION="1.0.0"
