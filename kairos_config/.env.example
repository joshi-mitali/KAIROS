# ==============================================================================
# KAIROS — Institutional Multi-Agent AI Trading System Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# Never commit real credentials to version control.

# Application Settings
KAIROS_ENV=development
LOG_LEVEL=INFO
KAIROS_DATA_DIR=data

# Indian Stock Market Scope (Target NSE Equities)
KAIROS_TARGET_TICKERS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
KAIROS_HISTORY_YEARS=10

# Existing MCP Server Configuration Path
KAIROS_MCP_CONFIG=

# ==============================================================================
# EXTERNAL MCP SERVER API CREDENTIALS & REQUIREMENTS
# ==============================================================================

# 1. Alpha Vantage MCP Server (BSE Equities, Daily Quotes, News Sentiment)
# ------------------------------------------------------------------------------
# Required for: Connecting to https://mcp.alphavantage.co/mcp?apikey={ALPHAVANTAGE_API_KEY}
# Registration: Free API key available at https://www.alphavantage.co/support/#api-key
# Constraints & Limits:
#   - Free tier: 25 requests per day, 5 requests per minute.
#   - Tickers: Indian equities require '.BSE' suffix (e.g., RELIANCE.BSE).
#   - Historical depth: Capped at 100 trading days ('compact') on free tier.
#     Full 10-year daily history requires premium subscription.
ALPHAVANTAGE_API_KEY=

# 2. Reddit MCP Server (r/IndianStockMarket, r/IndiaInvestments, r/dalalstreetbets)
# ------------------------------------------------------------------------------
# Required for: Reddit OAuth2 API access for sentiment ingestion.
# Registration Steps:
#   1. Sign in to your Reddit account.
#   2. Navigate to https://www.reddit.com/prefs/apps
#   3. Click "create another app..." at the bottom.
#   4. Select "script" (for personal agent bots).
#   5. Set redirect URI to http://localhost:8080 or http://127.0.0.1.
#   6. Copy the Client ID (displayed directly under the app name).
#   7. Copy the Secret key.
# Compliance Note: Per Reddit Data API terms, automated scraping without OAuth
# returns HTTP 403 Blocked. Valid API keys are required for live queries.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=kairos-academic-agent:v1.0 (by /u/academic_researcher)

# ==============================================================================
# OPTIONAL STORAGE BACKENDS
# ==============================================================================
# PostgreSQL / Supabase connection URI for structured financial metadata
DATABASE_URL=
# Langfuse — backend credentials only; never use VITE_ prefixes
KAIROS_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Optional Groq failover keys, comma separated; never commit real values
GROQ_API_KEYS=
KAIROS_PROMPT_GUARD_ENABLED=auto

# Web workspace (required before binding to a public interface)
KAIROS_WEB_HOST=127.0.0.1
KAIROS_WEB_PASSWORD=
PORT=8000
KAIROS_RUNTIME_DIR=data/runtime
MEGABULL_API_KEY=
